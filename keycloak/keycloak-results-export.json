{
  "realm": "reports-realm",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 5,
  "accessTokenLifespan": 120,
  "accessTokenLifespanForImplicitFlow": 120,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": [
    "totpAppFreeOTPName",
    "totpAppGoogleName",
    "totpAppMicrosoftAuthenticatorName"
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Обычный пользователь",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "administrator",
        "description": "Администратор системы",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "prothetic_user",
        "description": "Пилот протеза, имеет доступ к своим отчётам",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "reports-frontend",
      "name": "BionicPRO SPA + BFF",
      "description": "Публичный клиент, работает по Authorization Code Flow с PKCE (S256)",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:3000",
      "baseUrl": "http://localhost:3000",
      "redirectUris": [
        "http://localhost:8000/auth/callback",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*",
        "access.token.lifespan": "120"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "reports-api",
      "name": "Сервис отчётов",
      "description": "Ресурсный сервер, проверяет токен по JWKS",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
  "identityProviders": [
    {
      "alias": "yandex",
      "displayName": "Яндекс ID",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "changeme",
        "clientSecret": "changeme",
        "clientAuthMethod": "client_secret_post",
        "authorizationUrl": "https://oauth.yandex.ru/authorize",
        "tokenUrl": "https://oauth.yandex.ru/token",
        "userInfoUrl": "https://login.yandex.ru/info?format=json",
        "defaultScope": "login:email login:info",
        "syncMode": "FORCE",
        "useJwksUrl": "false",
        "pkceEnabled": "true",
        "pkceMethod": "S256"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "yandex-email",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claim": "default_email",
        "user.attribute": "email"
      }
    },
    {
      "name": "yandex-full-name",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claim": "real_name",
        "user.attribute": "fullName"
      }
    },
    {
      "name": "yandex-default-role",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "role": "prothetic_user"
      }
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "ldap-representative-office",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "username"
                ],
                "ldap.attribute": [
                  "uid"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "false"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "email"
                ],
                "ldap.attribute": [
                  "mail"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "false"
                ],
                "is.mandatory.in.ldap": [
                  "false"
                ]
              }
            },
            {
              "name": "first name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "firstName"
                ],
                "ldap.attribute": [
                  "cn"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "last name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "user.model.attribute": [
                  "lastName"
                ],
                "ldap.attribute": [
                  "sn"
                ],
                "read.only": [
                  "true"
                ],
                "always.read.value.from.ldap": [
                  "true"
                ],
                "is.mandatory.in.ldap": [
                  "true"
                ]
              }
            },
            {
              "name": "ldap-roles",
              "providerId": "role-ldap-mapper",
              "config": {
                "roles.dn": [
                  "ou=Groups,dc=example,dc=com"
                ],
                "role.name.ldap.attribute": [
                  "cn"
                ],
                "role.object.classes": [
                  "groupOfNames"
                ],
                "membership.ldap.attribute": [
                  "member"
                ],
                "membership.attribute.type": [
                  "DN"
                ],
                "membership.user.ldap.attribute": [
                  "uid"
                ],
                "roles.ldap.filter": [
                  ""
                ],
                "mode": [
                  "READ_ONLY"
                ],
                "user.roles.retrieve.strategy": [
                  "LOAD_ROLES_BY_MEMBER_ATTRIBUTE"
                ],
                "use.realm.roles.mapping": [
                  "true"
                ],
                "client.id": [
                  ""
                ]
              }
            }
          ]
        },
        "config": {
          "enabled": [
            "true"
          ],
          "priority": [
            "0"
          ],
          "vendor": [
            "other"
          ],
          "editMode": [
            "READ_ONLY"
          ],
          "importEnabled": [
            "true"
          ],
          "syncRegistrations": [
            "false"
          ],
          "connectionUrl": [
            "ldap://openldap:389"
          ],
          "usersDn": [
            "ou=People,dc=example,dc=com"
          ],
          "usernameLDAPAttribute": [
            "uid"
          ],
          "rdnLDAPAttribute": [
            "uid"
          ],
          "uuidLDAPAttribute": [
            "entryUUID"
          ],
          "userObjectClasses": [
            "inetOrgPerson, organizationalPerson"
          ],
          "authType": [
            "simple"
          ],
          "bindDn": [
            "cn=admin,dc=example,dc=com"
          ],
          "bindCredential": [
            "admin"
          ],
          "searchScope": [
            "1"
          ],
          "pagination": [
            "true"
          ],
          "batchSizeForSync": [
            "1000"
          ],
          "fullSyncPeriod": [
            "604800"
          ],
          "changedSyncPeriod": [
            "86400"
          ],
          "cachePolicy": [
            "DEFAULT"
          ],
          "useTruststoreSpi": [
            "ldapsOnly"
          ],
          "connectionPooling": [
            "true"
          ],
          "trustEmail": [
            "true"
          ]
        }
      }
    ]
  },
